{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Elastic: validate rules",
      "type": "process",
      "command": "${workspaceFolder}/.venv-elastic/bin/python",
      "args": [
        "-m",
        "detection_rules",
        "validate-all"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CUSTOM_RULES_DIR": "${workspaceFolder}",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv-elastic\\Scripts\\python.exe"
      }
    },
    {
      "label": "Elastic: test",
      "type": "process",
      "command": "${workspaceFolder}/.venv-elastic/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CUSTOM_RULES_DIR": "${workspaceFolder}",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": [],
      "group": "test",
      "windows": {
        "command": "${workspaceFolder}\\.venv-elastic\\Scripts\\python.exe"
      }
    },
    {
      "label": "Elastic: package rules",
      "type": "process",
      "command": "${workspaceFolder}/.venv-elastic/bin/python",
      "args": [
        "-m",
        "detection_rules",
        "export-rules-from-repo",
        "--directory",
        "rules",
        "--outfile",
        "artifacts/rules.ndjson"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CUSTOM_RULES_DIR": "${workspaceFolder}",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv-elastic\\Scripts\\python.exe"
      }
    },
    {
      "label": "Elastic: pull rule from Kibana",
      "type": "process",
      "command": "${workspaceFolder}/.venv-elastic/bin/python",
      "args": [
        "scripts/kibana.py",
        "pull",
        "--rule-id",
        "${input:pullRuleId}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CUSTOM_RULES_DIR": "${workspaceFolder}",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv-elastic\\Scripts\\python.exe"
      }
    }
  ],
  "inputs": [
    {
      "id": "pullRuleId",
      "type": "promptString",
      "description": "Kibana rule_id UUID to export for review (requires Bitwarden environment)"
    }
  ]
}
