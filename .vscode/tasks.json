{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DaC: validate rules",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dac",
        "validate"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "DaC: test",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "DaC: package rules",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dac",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "DaC: deployment plan (read only)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dac",
        "deploy"
      ],
      "problemMatcher": []
    },
    {
      "label": "DaC: pull rule from Kibana",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dac",
        "pull",
        "--rule-id",
        "${input:pullRuleId}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "pullRuleId",
      "type": "promptString",
      "description": "Kibana custom rule_id UUID (add gac-detections tag first)"
    }
  ]
}
