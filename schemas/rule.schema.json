{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAC custom detection rule (initial supported API subset)",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "name", "description", "author", "type", "language", "index", "query", "severity", "risk_score", "interval", "from", "enabled", "tags", "version"],
  "properties": {
    "rule_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 20},
    "author": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "type": {"enum": ["query", "eql"]},
    "language": {"enum": ["kuery", "eql"]},
    "index": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "query": {"type": "string", "minLength": 5},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "interval": {"type": "string", "pattern": "^[1-9][0-9]*[mh]$"},
    "from": {"type": "string", "pattern": "^now-[1-9][0-9]*[mhd]$"},
    "enabled": {"type": "boolean"},
    "tags": {"type": "array", "uniqueItems": true, "contains": {"const": "gac-detections"}, "items": {"type": "string", "minLength": 1}},
    "version": {"type": "integer", "minimum": 1},
    "max_signals": {"type": "integer", "minimum": 1, "maximum": 1000},
    "references": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "false_positives": {"type": "array", "items": {"type": "string"}},
    "note": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "query"}}}, "then": {"properties": {"language": {"const": "kuery"}}}},
    {"if": {"properties": {"type": {"const": "eql"}}}, "then": {"properties": {"language": {"const": "eql"}}}}
  ]
}
